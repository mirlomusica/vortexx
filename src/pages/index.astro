---
import Layout from "../layouts/Layout.astro";
import "animate.css";
---

<Layout>
    <div id="layout">
        <div id="hero">
            <video
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                poster="/images/loading.png"
            >
                <source src="/video/hero_video.webm" type="video/mp4" />
                <source src="/video/hero_video.mp4" type="video/mp4" />
            </video>
            <div id="overlay">
                <p style="color:rgb(197, 126, 126)">FEEL</p>
                <p style="color: rgb(145, 230, 233);">THE</p>
                <p style="color: rgb(172, 26, 26);"><b>RUSH</b></p>
            </div>
        </div>
        <picture id="logo" class="animate__animated animate__bounce">
            <source srcset="/images/vortexx-logo.avif" />
            <source srcset="/images/vortexx-logo.webp" />
            <img src="/images/vortexx-logo.png" alt="vortexx classic" />
        </picture>
        <div id="cans">
            <a href="/vortexx_max">
                <picture class="animate__animated animate__bounce can">
                    <source srcset="/images/vortexx-max.avif" />
                    <source srcset="/images/vortexx-max.webp" />
                    <img src="/images/vortexx-max.png" alt="vortexx classic" />
                </picture>
            </a>

            <a href="/vortexx_mint">
                <picture class="animate__animated animate__bounce can">
                    <source srcset="/images/vortexx-mint.avif" />
                    <source srcset="/images/vortexx-mint.webp" />
                    <img src="/images/vortexx-mint.png" alt="vortexx mint" />
                </picture>
            </a>

            <a href="/vortexx_lemon">
                <picture class="animate__animated animate__bounce can">
                    <source srcset="/images/vortexx-lemon.avif" />
                    <source srcset="/images/vortexx-lemon.webp" />
                    <img src="/images/vortexx-lemon.png" alt="vortexx lemon" />
                </picture>
            </a>

            <a href="/vortexx_light">
                <picture class="animate__animated animate__bounce can">
                    <source srcset="/images/vortexx-light.avif" />
                    <source srcset="/images/vortexx-light.webp" />
                    <img src="/images/vortexx-light.png" alt="vortexx light" />
                </picture>
            </a>
        </div>
    </div>
    <div id="pitch">
        <div id="text">
            <h1>FEEL THE RUSH</h1>
            <h2>Ride the wave harder, longer, and with unstoppable energy.</h2>
            <p>
                Vortexx is built for surfers who chase the thrill—packed with a
                surge of revitalizing power that keeps you sharp, focused, and
                ready for every swell. Whether you're carving through glassy
                barrels or pushing past your limits, Vortexx fuels your flow so
                you never miss the moment—available in four bold flavors: Mint,
                Max, Lemon, and Light.
            </p>
        </div>
        <img src="/images/cans.gif" alt="cans spinning" />
    </div>
    <style>
        #layout {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        #cans {
            display: flex;
            flex-wrap: wrap;
            width: 100%;
            box-sizing: border-box;
            text-align: center;
            justify-content: center;
            gap: 2rem;
            padding: 10%;

            background: url(images/waves.jpg) top center;
            background-size: cover;
            background-attachment: fixed;
        }
        img {
            max-width: 100%;
            height: auto;
        }

        a:hover {
            animation-duration: 10s;
            background-color: rgb(1, 104, 104);
            border-radius: 10px;
            box-shadow: 1px 1px 50px 50px rgb(1, 104, 104);
        }
        #hero {
            width: 100%;
            overflow: hidden;
        }
        #hero video {
            display: block;
            width: 100%;
            height: auto;
        }
        #hero #overlay {
            position: absolute;

            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            text-shadow:
                1px 1px 5px,
                1px 1px 5px;
            font-style: italic;
            font-size: 5vw;
            top: 15vw;
            left: 10vw;
        }
        #pitch {
            display: flex;

            flex-wrap: wrap;
            text-align: center;
            justify-content: center;
            flex-direction: row;
            align-items: center;
            gap: 2rem;
            margin: 5%;
        }
        #pitch #text {
            display: flex;
            flex-direction: column;
            align-items: left;
            text-align: left;

            align-self: stretch;
            background-color: rgb(56, 219, 219);
            width: 40%;
            padding: 2rem;
            box-shadow: 0 0 20px 10px rgba(56, 219, 219, 0.6);
            border-radius: 5px;
        }
        #pitch #text h1 {
            color: rgb(7, 56, 56);
            text-shadow: 0 0 20px 10px;
        }
        #pitch #text h2 {
            color: rgb(10, 97, 97);
            text-shadow: 0 0 20px 10px;
        }
        #pitch #text p {
            color: rgb(11, 88, 88);
        }
    </style>
</Layout>
