---
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <Nav />
        <slot />
        <Foot />
    </body>
</html>

<style>
    @font-face {
        font-family: "Poppins";
        src: url("https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap");
    }
    html,
    body {
        margin: 0 auto;
        display: inline-block;
        background-color: black;
        color: aqua;
        width: 100%;
        font-family: "Poppins", sans-serif;
        font-weight: 100;
        font-style: normal;
        justify-self: center;
    }
    #cans {
        color: red;
        display: flex;
        gap: 10px;
    }
</style>
